#!/usr/bin/env bash
# install-dotfiles — déploie la configuration bash + vim + neovim de ce repo.
# Idempotent : peut être relancé sans casser ce qui est déjà en place.
#
# Étapes :
#   1. outils CLI (vim, git, ripgrep, unzip via apt ; fzf récent depuis GitHub)
#   2. plugins vim en packages natifs (fzf, fzf.vim)
#   3. Neovim 0.12 et les outils de sa config : lazygit, fd, tree-sitter et les
#      serveurs LSP (Rust, C/C++, Python, Java, Lua, bash, JavaScript/TypeScript)
#   4. symlinks .profile / .bash_profile / .bashrc / .vimrc / .config/nvim vers $HOME
#   5. plugins Neovim (vim.pack) et parsers treesitter
#
# Usage :
#   ./install-dotfiles                     # depuis n'importe où
#   DOTFILES=/chemin/vers/my_dotfiles ./install-dotfiles

set -euo pipefail

# Par défaut : la racine du repo qui contient ce script (.local/bin/..).
_self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES="${DOTFILES:-$(cd "$_self/../.." && pwd)}"
if [[ ! -f "$DOTFILES/.bashrc" ]]; then
    echo "❌ DOTFILES ne ressemble pas au repo : $DOTFILES" >&2
    exit 1
fi

FZF_VERSION="${FZF_VERSION:-v0.74.3}"
FZF_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/fzf"
VIM_PACK="$HOME/.vim/pack/dotfiles/start"

# Binaires précompilés de la section Neovim, posés dans ~/.local/opt/<nom>-<version>.
# Changer une version impose de changer son empreinte : champ « digest » de
# l'asset dans l'API GitHub (repos/<owner>/<repo>/releases/tags/<tag>), ou
# fichier .sha256 publié à côté de l'archive pour jdtls.
OPT="$HOME/.local/opt"
NVIM="$HOME/.local/bin/nvim"
NVIM_VERSION="v0.12.5"
NVIM_SHA256="bce0f56eda1f1b1db6eee8f4133d7a38813ea07933837dd1777411ca384c6875"
LAZYGIT_VERSION="0.65.0"
LAZYGIT_SHA256="44d8e7dd1484b4a66e191bd4ab25a71e8b4b3a65ab122f838e65677ef58c5506"
FD_VERSION="v10.5.0"
FD_SHA256="761c72dc8e120d85b22292063be8a796e2eeb20eb3e4f38b8fa2343ccf3514a7"
LUALS_VERSION="3.19.1"
LUALS_SHA256="e9235d2d72ef55bc41cf8c99cda2ed64777682024b4bb81f5dea425060c5cbb8"
CLANGD_VERSION="22.1.6"
CLANGD_SHA256="a9c77443af2e447ed467e84771848d3a6ac1c56f84bcfcde717e66318de77cfa"
JDK_VERSION="21.0.12.1+1"
JDK_SHA256="ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94"
JDTLS_VERSION="1.61.0"
JDTLS_BUILD="202609031315" # horodatage du nom d'archive, cf. <milestone>/latest.txt
JDTLS_SHA256="338e7e73d61836651ba2453919a0d34fa763eb4e7c03342092309bffb8934c64"
SHELLCHECK_VERSION="v0.11.0"
SHELLCHECK_SHA256="b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6"
SHFMT_VERSION="v3.14.1"
SHFMT_SHA256="76e77641faa025814b77f153b29796b8e6fa2fca03e0c76a691608b86c7ea7bf"
# Installés par cargo / uv / npm, qui vérifient eux-mêmes ce qu'ils téléchargent.
TREE_SITTER_VERSION="0.26.13"
BASEDPYRIGHT_VERSION="1.40.0"
BASHLS_VERSION="5.6.0"
TSLS_VERSION="5.3.0"       # la 6.x exige Node 22, nvm fournit Node 20
TYPESCRIPT_VERSION="6.0.3" # ts_ls ne pilote pas encore TypeScript 7 (réécriture native)
# Parsers treesitter posés d'office (les autres : :TSInstall <langage>).
TS_PARSERS=(rust c cpp java python bash javascript typescript tsx)

say()  { printf '\033[1;36m▶\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*"; }

say "Dotfiles : $DOTFILES"

# ── 1. outils CLI ───────────────────────────────────────────────────────
say "Vérif/install des outils CLI"
if command -v apt-get >/dev/null; then
    pkgs=(vim git ripgrep unzip)
    to_install=()
    for p in "${pkgs[@]}"; do
        dpkg -s "$p" &>/dev/null || to_install+=("$p")
    done
    if (( ${#to_install[@]} > 0 )); then
        say "sudo apt-get install ${to_install[*]}"
        sudo apt-get update -qq && sudo apt-get install -y "${to_install[@]}"
    else
        ok "paquets apt déjà installés"
    fi
else
    warn "apt-get introuvable — installe manuellement : vim git ripgrep unzip"
fi

# fzf : le paquet apt est figé sur une version ancienne (0.29 sur cette
# machine), trop vieille pour le fzf.vim actuel et sans `fzf --bash`. On pose
# le binaire officiel dans ~/.local/share/fzf, exposé via ~/.local/bin.
if [[ -x "$FZF_HOME/bin/fzf" ]]; then
    ok "fzf $("$FZF_HOME/bin/fzf" --version | cut -d' ' -f1) déjà installé dans $FZF_HOME"
else
    say "install fzf $FZF_VERSION dans $FZF_HOME"
    git clone --depth 1 --branch "$FZF_VERSION" -q https://github.com/junegunn/fzf.git "$FZF_HOME"
    "$FZF_HOME/install" --bin >/dev/null
    ok "fzf $FZF_VERSION installé"
fi
mkdir -p "$HOME/.local/bin"
ln -sfn "$FZF_HOME/bin/fzf"      "$HOME/.local/bin/fzf"
ln -sfn "$FZF_HOME/bin/fzf-tmux" "$HOME/.local/bin/fzf-tmux"
ok "~/.local/bin/fzf → $FZF_HOME/bin/fzf"

# ── 2. plugins vim ──────────────────────────────────────────────────────
say "Plugins vim dans $VIM_PACK"
mkdir -p "$VIM_PACK"
# Le dépôt fzf embarque le plugin vim de base (fzf#run / fzf#wrap), dont
# fzf.vim dépend : on le branche par symlink plutôt que de le recloner.
ln -sfn "$FZF_HOME" "$VIM_PACK/fzf"
ok "fzf (plugin de base) → $FZF_HOME"

if [[ -d "$VIM_PACK/fzf.vim" ]]; then
    ok "fzf.vim déjà cloné"
else
    git clone --depth 1 -q https://github.com/junegunn/fzf.vim.git "$VIM_PACK/fzf.vim"
    ok "fzf.vim cloné"
fi

if command -v vim >/dev/null && [[ -d "$VIM_PACK/fzf.vim/doc" ]]; then
    vim -es -u NONE -c "helptags $VIM_PACK/fzf.vim/doc" -c q >/dev/null 2>&1 || true
    ok "tags d'aide générés (:help fzf-vim)"
fi

# ── 3. Neovim et outils de sa config ────────────────────────────────────
# Le paquet apt est figé sur 0.6, la config repose sur vim.pack (0.12). Comme
# pour fzf, on pose les binaires officiels exposés via ~/.local/bin : pas de
# sudo, et le paquet apt peut rester, masqué par le PATH.
say "Neovim et outils de sa config"

# install_release NOM URL SHA256 DEST [STRIP] : télécharge une archive (.tar.*,
# .zip) ou un binaire nu, vérifie son empreinte puis l'extrait dans DEST ;
# STRIP=1 retire le dossier racine de l'archive. L'extraction passe par un
# dossier temporaire : DEST n'apparaît que complet, son existence suffit donc
# à savoir que l'install est faite.
install_release() {
    local name="$1" url="$2" sha="$3" dest="$4" strip="${5:-0}" tmp
    if [[ -d "$dest" ]]; then
        ok "$name déjà installé dans $dest"
        return 0
    fi
    say "install $name dans $dest"
    tmp="$(mktemp -d)"
    curl -fsSL -o "$tmp/archive" "$url"
    if ! echo "$sha  $tmp/archive" | sha256sum -c --status; then
        rm -rf "$tmp"
        echo "❌ $name : empreinte SHA-256 inattendue ($url)" >&2
        exit 1
    fi
    mkdir -p "$tmp/x" "$(dirname "$dest")"
    case "$url" in
        *.zip)
            unzip -q "$tmp/archive" -d "$tmp/x"
            # unzip ne sait pas retirer de niveau : on remonte l'unique dossier racine.
            if (( strip == 1 )); then
                mv "$tmp/x" "$tmp/z" && mv "$tmp/z"/*/ "$tmp/x"
            fi
            ;;
        *.tar.*|*.tgz)
            tar xf "$tmp/archive" -C "$tmp/x" --strip-components="$strip"
            ;;
        *)
            # Binaire nu : gardé sous le nom de son URL.
            install -m 755 "$tmp/archive" "$tmp/x/${url##*/}"
            ;;
    esac
    mv "$tmp/x" "$dest"
    rm -rf "$tmp"
    ok "$name installé"
}

if [[ "$(uname -m)" != x86_64 ]]; then
    warn "binaires précompilés x86_64 uniquement — Neovim, lazygit, fd, lua-language-server, clangd, jdtls, shellcheck et shfmt non installés"
else
    install_release "Neovim $NVIM_VERSION" \
        "https://github.com/neovim/neovim/releases/download/$NVIM_VERSION/nvim-linux-x86_64.tar.gz" \
        "$NVIM_SHA256" "$OPT/nvim-$NVIM_VERSION" 1
    ln -sfn "$OPT/nvim-$NVIM_VERSION/bin/nvim" "$NVIM"
    ok "~/.local/bin/nvim → $OPT/nvim-$NVIM_VERSION/bin/nvim"

    # Snacks.lazygit() ne fait que lancer ce binaire dans une fenêtre flottante.
    install_release "lazygit $LAZYGIT_VERSION" \
        "https://github.com/jesseduffield/lazygit/releases/download/v$LAZYGIT_VERSION/lazygit_${LAZYGIT_VERSION}_linux_x86_64.tar.gz" \
        "$LAZYGIT_SHA256" "$OPT/lazygit-$LAZYGIT_VERSION"
    ln -sfn "$OPT/lazygit-$LAZYGIT_VERSION/lazygit" "$HOME/.local/bin/lazygit"
    ok "~/.local/bin/lazygit → $OPT/lazygit-$LAZYGIT_VERSION/lazygit"

    # fd : requis par la recherche dans l'explorateur Snacks (Espace fe). Build
    # musl statique, indépendant de la glibc. Active au passage l'alias
    # `fd -HI` de .bashrc.
    install_release "fd $FD_VERSION" \
        "https://github.com/sharkdp/fd/releases/download/$FD_VERSION/fd-$FD_VERSION-x86_64-unknown-linux-musl.tar.gz" \
        "$FD_SHA256" "$OPT/fd-$FD_VERSION" 1
    ln -sfn "$OPT/fd-$FD_VERSION/fd" "$HOME/.local/bin/fd"
    ok "~/.local/bin/fd → $OPT/fd-$FD_VERSION/fd"

    # Serveur lua_ls. Il retrouve ses scripts depuis son vrai chemin : un
    # symlink suffit, pas besoin de wrapper.
    install_release "lua-language-server $LUALS_VERSION" \
        "https://github.com/LuaLS/lua-language-server/releases/download/$LUALS_VERSION/lua-language-server-$LUALS_VERSION-linux-x64.tar.gz" \
        "$LUALS_SHA256" "$OPT/lua-language-server-$LUALS_VERSION"
    ln -sfn "$OPT/lua-language-server-$LUALS_VERSION/bin/lua-language-server" "$HOME/.local/bin/lua-language-server"
    ok "~/.local/bin/lua-language-server → $OPT/lua-language-server-$LUALS_VERSION/bin/lua-language-server"

    # Serveur clangd (C, C++). Build LLVM officiel : embarque ses en-têtes
    # internes et retrouve seul ceux de la libc et de libstdc++ (gcc).
    install_release "clangd $CLANGD_VERSION" \
        "https://github.com/clangd/clangd/releases/download/$CLANGD_VERSION/clangd-linux-$CLANGD_VERSION.zip" \
        "$CLANGD_SHA256" "$OPT/clangd-$CLANGD_VERSION" 1
    ln -sfn "$OPT/clangd-$CLANGD_VERSION/bin/clangd" "$HOME/.local/bin/clangd"
    ok "~/.local/bin/clangd → $OPT/clangd-$CLANGD_VERSION/bin/clangd"

    # Serveur jdtls (Java). Son lanceur refuse Java < 21 alors que le JDK d'apt
    # est en 17 : on pose un JDK 21 qui ne sert qu'à jdtls. Le java du PATH et
    # le JAVA_HOME du shell restent ceux des projets.
    install_release "JDK $JDK_VERSION (Temurin)" \
        "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-${JDK_VERSION/+/%2B}/OpenJDK21U-jdk_x64_linux_hotspot_${JDK_VERSION/+/_}.tar.gz" \
        "$JDK_SHA256" "$OPT/jdk-$JDK_VERSION" 1
    install_release "jdtls $JDTLS_VERSION" \
        "https://download.eclipse.org/jdtls/milestones/$JDTLS_VERSION/jdt-language-server-$JDTLS_VERSION-$JDTLS_BUILD.tar.gz" \
        "$JDTLS_SHA256" "$OPT/jdtls-$JDTLS_VERSION"
    # Wrapper plutôt que symlink : c'est lui qui passe le JDK 21 au lanceur.
    cat > "$HOME/.local/bin/jdtls" <<EOF
#!/bin/sh
# Généré par install-dotfiles : lance jdtls avec le JDK 21 qu'il exige.
export JAVA_HOME="$OPT/jdk-$JDK_VERSION"
exec "$OPT/jdtls-$JDTLS_VERSION/bin/jdtls" "\$@"
EOF
    chmod +x "$HOME/.local/bin/jdtls"
    ok "~/.local/bin/jdtls → jdtls $JDTLS_VERSION sous JDK $JDK_VERSION"

    # Outils appelés par bashls : shellcheck pour les diagnostics, shfmt pour
    # le formatage. Binaires autonomes.
    install_release "shellcheck $SHELLCHECK_VERSION" \
        "https://github.com/koalaman/shellcheck/releases/download/$SHELLCHECK_VERSION/shellcheck-$SHELLCHECK_VERSION.linux.x86_64.tar.gz" \
        "$SHELLCHECK_SHA256" "$OPT/shellcheck-$SHELLCHECK_VERSION" 1
    ln -sfn "$OPT/shellcheck-$SHELLCHECK_VERSION/shellcheck" "$HOME/.local/bin/shellcheck"
    ok "~/.local/bin/shellcheck → $OPT/shellcheck-$SHELLCHECK_VERSION/shellcheck"
    install_release "shfmt $SHFMT_VERSION" \
        "https://github.com/mvdan/sh/releases/download/$SHFMT_VERSION/shfmt_${SHFMT_VERSION}_linux_amd64" \
        "$SHFMT_SHA256" "$OPT/shfmt-$SHFMT_VERSION"
    ln -sfn "$OPT/shfmt-$SHFMT_VERSION/shfmt_${SHFMT_VERSION}_linux_amd64" "$HOME/.local/bin/shfmt"
    ok "~/.local/bin/shfmt → $OPT/shfmt-$SHFMT_VERSION/shfmt_${SHFMT_VERSION}_linux_amd64"
fi

# Serveur rust_analyzer : composant rustup, aligné sur la toolchain active.
if command -v rustup >/dev/null; then
    if rustup component list --installed | grep -q '^rust-analyzer'; then
        ok "rust-analyzer déjà installé"
    else
        rustup component add rust-analyzer
        ok "rust-analyzer installé"
    fi
else
    warn "rustup introuvable — rust-analyzer non installé"
fi

# Serveur basedpyright (Python), via uv : environnement isolé qui embarque son
# node, donc indépendant de la version active de nvm (un `npm i -g pyright`
# n'est visible que sous la version de Node qui l'a installé).
if command -v uv >/dev/null; then
    if uv tool list 2>/dev/null | grep -qx "basedpyright v$BASEDPYRIGHT_VERSION"; then
        ok "basedpyright $BASEDPYRIGHT_VERSION déjà installé"
    else
        uv tool install "basedpyright==$BASEDPYRIGHT_VERSION"
        ok "basedpyright $BASEDPYRIGHT_VERSION installé"
    fi
else
    warn "uv introuvable — basedpyright (Python) non installé"
fi

# Serveurs bashls et ts_ls (JavaScript, TypeScript, React), écrits en JS : npm
# les installe chacun dans son préfixe plutôt qu'en `npm i -g`, lié à une
# version de Node de nvm. Ils survivent donc à un `nvm use`, mais demandent un
# node >= 20 dans le PATH pour démarrer.
# install_npm NOM DEST PAQUET@VERSION… : même logique d'idempotence que
# install_release (DEST n'apparaît que complet).
install_npm() {
    local name="$1" dest="$2" tmp
    shift 2
    if [[ -d "$dest" ]]; then
        ok "$name déjà installé dans $dest"
        return 0
    fi
    say "install $name dans $dest"
    tmp="$(mktemp -d)"
    npm install --prefix "$tmp" --no-audit --no-fund --loglevel=error "$@" >/dev/null
    mkdir -p "$(dirname "$dest")"
    mv "$tmp" "$dest"
    ok "$name installé"
}

if command -v npm >/dev/null; then
    install_npm "bash-language-server $BASHLS_VERSION" \
        "$OPT/bash-language-server-$BASHLS_VERSION" "bash-language-server@$BASHLS_VERSION"
    ln -sfn "$OPT/bash-language-server-$BASHLS_VERSION/node_modules/.bin/bash-language-server" "$HOME/.local/bin/bash-language-server"
    ok "~/.local/bin/bash-language-server → $OPT/bash-language-server-$BASHLS_VERSION"

    # TypeScript installé à côté du serveur : utilisé quand le projet n'a pas
    # le sien dans node_modules.
    TSLS_HOME="$OPT/typescript-language-server-$TSLS_VERSION-ts$TYPESCRIPT_VERSION"
    install_npm "typescript-language-server $TSLS_VERSION (TypeScript $TYPESCRIPT_VERSION)" \
        "$TSLS_HOME" "typescript-language-server@$TSLS_VERSION" "typescript@$TYPESCRIPT_VERSION"
    ln -sfn "$TSLS_HOME/node_modules/.bin/typescript-language-server" "$HOME/.local/bin/typescript-language-server"
    ok "~/.local/bin/typescript-language-server → $TSLS_HOME"
else
    warn "npm introuvable (nvm pas chargé ?) — bash-language-server et typescript-language-server non installés"
fi

# tree-sitter CLI, requis par :TSInstall. Les binaires officiels exigent glibc
# 2.39 (jammy : 2.35), on le compile donc. Sans la feature par défaut qjs-rt :
# son runtime QuickJS passe par bindgen, qui réclame libclang (apt, donc sudo).
# `tree-sitter generate` utilise alors node.
if tree-sitter --version 2>/dev/null | grep -qF " $TREE_SITTER_VERSION"; then
    ok "tree-sitter $TREE_SITTER_VERSION déjà installé"
elif command -v cargo >/dev/null; then
    say "cargo install tree-sitter-cli $TREE_SITTER_VERSION (quelques minutes)"
    cargo install --locked --no-default-features tree-sitter-cli --version "$TREE_SITTER_VERSION"
    ok "tree-sitter $TREE_SITTER_VERSION installé"
else
    warn "cargo introuvable — ni tree-sitter (:TSInstall) ni la lib Rust de blink.cmp ne pourront être compilés"
fi

# ── 4. symlinks ─────────────────────────────────────────────────────────
say "Symlinks dotfiles → \$HOME"

link() {
    local src="$1" dst="$2"
    if [[ -L "$dst" ]]; then
        local current
        current=$(readlink "$dst")
        if [[ "$current" == "$src" ]]; then
            ok "$dst → $src (déjà OK)"
            return 0
        fi
        warn "$dst pointe vers $current — remplacé"
        rm "$dst"
    elif [[ -e "$dst" ]]; then
        warn "$dst existe et n'est pas un symlink — backup vers $dst.bak"
        mv "$dst" "$dst.bak"
    fi
    ln -s "$src" "$dst"
    ok "$dst → $src"
}

link "$DOTFILES/.profile"      "$HOME/.profile"
link "$DOTFILES/.bash_profile" "$HOME/.bash_profile"
link "$DOTFILES/.bashrc"       "$HOME/.bashrc"
link "$DOTFILES/.vimrc"        "$HOME/.vimrc"
mkdir -p "$HOME/.config"
# Le dossier entier, pas seulement init.lua : vim.pack écrit son lockfile à
# côté, qui atterrit ainsi dans le repo.
link "$DOTFILES/.config/nvim"  "$HOME/.config/nvim"

# ── 5. plugins Neovim ───────────────────────────────────────────────────
# Un lancement sans interface suffit : vim.pack clone les plugins aux révisions
# de nvim-pack-lock.json (stdin n'étant pas un terminal, sa confirmation prend
# la réponse par défaut, « Yes »), puis init.lua compile la lib Rust de
# blink.cmp. Relancé, il ne refait rien.
if [[ -x "$NVIM" ]]; then
    say "Plugins Neovim (vim.pack) et compilation de blink.cmp"
    "$NVIM" --headless +qa </dev/null
    ok "plugins Neovim installés"

    # install() saute les parsers déjà présents.
    if command -v tree-sitter >/dev/null; then
        "$NVIM" --headless \
            -c "lua require('nvim-treesitter').install({ $(printf "'%s', " "${TS_PARSERS[@]}") }):wait(300000)" \
            -c qa </dev/null
        ok "parsers treesitter installés : ${TS_PARSERS[*]}"
    fi
fi

# ── Fin ─────────────────────────────────────────────────────────────────
echo
ok "Setup terminé."
echo
echo "  Vérifications :"
echo "    - nouveau shell (ou 'exec bash -l'), puis Ctrl-R → fzf s'ouvre"
echo "    - 'fzf --version' doit afficher ${FZF_VERSION#v} (pas la version apt)"
echo "    - dans vim : ':Rg motif' puis Entrée sur un résultat"
echo "    - 'nvim --version' doit afficher $NVIM_VERSION (pas la 0.6 d'apt)"
echo "    - dans nvim : Espace ff (fichiers), Espace fg (grep)"
echo "    - dans nvim, sur un .rs / .c / .py / .java / .sh / .ts : ':checkhealth vim.lsp' liste le serveur attaché"
echo
echo "  Config propre à cette machine : ~/.profile.local et ~/.bashrc.local"
echo "  (non trackés, sourcés automatiquement s'ils existent)"
