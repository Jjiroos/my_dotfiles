#!/usr/bin/env bash
# install-dotfiles — déploie la configuration bash + vim de ce repo.
# Idempotent : peut être relancé sans casser ce qui est déjà en place.
#
# Étapes :
#   1. outils CLI (vim, git, ripgrep via apt ; fzf récent depuis GitHub)
#   2. plugins vim en packages natifs (fzf, fzf.vim)
#   3. symlinks .profile / .bash_profile / .bashrc / .vimrc vers $HOME
#
# Usage :
#   ./install-dotfiles                     # depuis n'importe où
#   DOTFILES=/chemin/vers/my_dotfiles ./install-dotfiles

set -euo pipefail

# Par défaut : la racine du repo qui contient ce script (.local/bin/..).
_self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES="${DOTFILES:-$(cd "$_self/../.." && pwd)}"
if [[ ! -f "$DOTFILES/.bashrc" ]]; then
    echo "❌ DOTFILES ne ressemble pas au repo : $DOTFILES" >&2
    exit 1
fi

FZF_VERSION="${FZF_VERSION:-v0.74.3}"
FZF_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/fzf"
VIM_PACK="$HOME/.vim/pack/dotfiles/start"

say()  { printf '\033[1;36m▶\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*"; }

say "Dotfiles : $DOTFILES"

# ── 1. outils CLI ───────────────────────────────────────────────────────
say "Vérif/install des outils CLI"
if command -v apt-get >/dev/null; then
    pkgs=(vim git ripgrep)
    to_install=()
    for p in "${pkgs[@]}"; do
        dpkg -s "$p" &>/dev/null || to_install+=("$p")
    done
    if (( ${#to_install[@]} > 0 )); then
        say "sudo apt-get install ${to_install[*]}"
        sudo apt-get update -qq && sudo apt-get install -y "${to_install[@]}"
    else
        ok "paquets apt déjà installés"
    fi
else
    warn "apt-get introuvable — installe manuellement : vim git ripgrep"
fi

# fzf : le paquet apt est figé sur une version ancienne (0.29 sur cette
# machine), trop vieille pour le fzf.vim actuel et sans `fzf --bash`. On pose
# le binaire officiel dans ~/.local/share/fzf, exposé via ~/.local/bin.
if [[ -x "$FZF_HOME/bin/fzf" ]]; then
    ok "fzf $("$FZF_HOME/bin/fzf" --version | cut -d' ' -f1) déjà installé dans $FZF_HOME"
else
    say "install fzf $FZF_VERSION dans $FZF_HOME"
    git clone --depth 1 --branch "$FZF_VERSION" -q https://github.com/junegunn/fzf.git "$FZF_HOME"
    "$FZF_HOME/install" --bin >/dev/null
    ok "fzf $FZF_VERSION installé"
fi
mkdir -p "$HOME/.local/bin"
ln -sfn "$FZF_HOME/bin/fzf"      "$HOME/.local/bin/fzf"
ln -sfn "$FZF_HOME/bin/fzf-tmux" "$HOME/.local/bin/fzf-tmux"
ok "~/.local/bin/fzf → $FZF_HOME/bin/fzf"

# ── 2. plugins vim ──────────────────────────────────────────────────────
say "Plugins vim dans $VIM_PACK"
mkdir -p "$VIM_PACK"
# Le dépôt fzf embarque le plugin vim de base (fzf#run / fzf#wrap), dont
# fzf.vim dépend : on le branche par symlink plutôt que de le recloner.
ln -sfn "$FZF_HOME" "$VIM_PACK/fzf"
ok "fzf (plugin de base) → $FZF_HOME"

if [[ -d "$VIM_PACK/fzf.vim" ]]; then
    ok "fzf.vim déjà cloné"
else
    git clone --depth 1 -q https://github.com/junegunn/fzf.vim.git "$VIM_PACK/fzf.vim"
    ok "fzf.vim cloné"
fi

if command -v vim >/dev/null && [[ -d "$VIM_PACK/fzf.vim/doc" ]]; then
    vim -es -u NONE -c "helptags $VIM_PACK/fzf.vim/doc" -c q >/dev/null 2>&1 || true
    ok "tags d'aide générés (:help fzf-vim)"
fi

# ── 3. symlinks ─────────────────────────────────────────────────────────
say "Symlinks dotfiles → \$HOME"

link() {
    local src="$1" dst="$2"
    if [[ -L "$dst" ]]; then
        local current
        current=$(readlink "$dst")
        if [[ "$current" == "$src" ]]; then
            ok "$dst → $src (déjà OK)"
            return 0
        fi
        warn "$dst pointe vers $current — remplacé"
        rm "$dst"
    elif [[ -e "$dst" ]]; then
        warn "$dst existe et n'est pas un symlink — backup vers $dst.bak"
        mv "$dst" "$dst.bak"
    fi
    ln -s "$src" "$dst"
    ok "$dst → $src"
}

link "$DOTFILES/.profile"      "$HOME/.profile"
link "$DOTFILES/.bash_profile" "$HOME/.bash_profile"
link "$DOTFILES/.bashrc"       "$HOME/.bashrc"
link "$DOTFILES/.vimrc"        "$HOME/.vimrc"

# ── Fin ─────────────────────────────────────────────────────────────────
echo
ok "Setup terminé."
echo
echo "  Vérifications :"
echo "    - nouveau shell (ou 'exec bash -l'), puis Ctrl-R → fzf s'ouvre"
echo "    - 'fzf --version' doit afficher ${FZF_VERSION#v} (pas la version apt)"
echo "    - dans vim : ':Rg motif' puis Entrée sur un résultat"
echo
echo "  Config propre à cette machine : ~/.profile.local et ~/.bashrc.local"
echo "  (non trackés, sourcés automatiquement s'ils existent)"
